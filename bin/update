#!/bin/bash
# =============================================================================
# UPDATE SCRIPT - Update Anvil, Guardian, and Dependencies
# =============================================================================
# Usage: bin/update {all|anvil|guardian|node|deps|version}
# =============================================================================

set -e
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"
WORMHOLE_DIR="$ROOT_DIR/../WormHole-Official-GitHub-Repo"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info()  { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn()  { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }
log_step()  { echo -e "${BLUE}[STEP]${NC} $1"; }

show_versions() {
    echo "================================"
    echo "Current Versions"
    echo "================================"
    
    # Anvil (Foundry)
    if command -v anvil &> /dev/null; then
        echo -e "Anvil:    $(anvil --version 2>/dev/null | head -1)"
    else
        echo -e "Anvil:    ${RED}Not installed${NC}"
    fi
    
    # Cast (Foundry)
    if command -v cast &> /dev/null; then
        echo -e "Cast:     $(cast --version 2>/dev/null | head -1)"
    else
        echo -e "Cast:     ${RED}Not installed${NC}"
    fi
    
    # Guardiand
    GUARDIAND="$ROOT_DIR/../WormHole-Official-GitHub-Repo/build/bin/guardiand"
    if [ -f "$GUARDIAND" ]; then
        VERSION=$("$GUARDIAND" version 2>/dev/null | head -1 || echo "unknown")
        echo -e "Guardian: $VERSION"
    else
        echo -e "Guardian: ${RED}Not built${NC}"
    fi
    
    # Node.js
    if command -v node &> /dev/null; then
        echo -e "Node.js:  $(node --version)"
    else
        echo -e "Node.js:  ${RED}Not installed${NC}"
    fi
    
    # Go
    if command -v go &> /dev/null; then
        echo -e "Go:       $(go version | awk '{print $3}')"
    else
        echo -e "Go:       ${RED}Not installed${NC}"
    fi
    
    echo ""
}

update_anvil() {
    log_step "Updating Foundry (Anvil, Cast, Forge)..."
    
    # Check if running
    if [ -f "$ROOT_DIR/data/anvil.pid" ]; then
        PID=$(cat "$ROOT_DIR/data/anvil.pid")
        if kill -0 "$PID" 2>/dev/null; then
            log_warn "Anvil is running. Stop it first with: bin/anvil stop"
            return 1
        fi
    fi
    
    # Update via foundryup
    if command -v foundryup &> /dev/null; then
        log_info "Updating via foundryup..."
        foundryup
        log_info "Foundry updated!"
        anvil --version
    elif [ -f "$HOME/.foundry/bin/foundryup" ]; then
        log_info "Updating via foundryup..."
        "$HOME/.foundry/bin/foundryup"
        log_info "Foundry updated!"
    else
        log_error "foundryup not found. Install Foundry first:"
        echo "  curl -L https://foundry.paradigm.xyz | bash"
        echo "  source ~/.bashrc"
        echo "  foundryup"
        return 1
    fi
}

update_guardian() {
    log_step "Updating Guardian (guardiand)..."
    
    # Check if running
    if [ -f "$ROOT_DIR/data/guardian-0.pid" ]; then
        PID=$(cat "$ROOT_DIR/data/guardian-0.pid")
        if kill -0 "$PID" 2>/dev/null; then
            log_warn "Guardian is running. Stop it first with: bin/guardian stop"
            return 1
        fi
    fi
    
    if [ ! -d "$WORMHOLE_DIR" ]; then
        log_error "Wormhole repository not found at: $WORMHOLE_DIR"
        echo "Clone it first:"
        echo "  git clone https://github.com/wormhole-foundation/wormhole.git $WORMHOLE_DIR"
        return 1
    fi
    
    # Update repository
    log_info "Pulling latest changes..."
    cd "$WORMHOLE_DIR"
    git fetch origin
    
    # Show available tags
    LATEST_TAG=$(git describe --tags --abbrev=0 origin/main 2>/dev/null || echo "")
    CURRENT_TAG=$(git describe --tags --abbrev=0 2>/dev/null || echo "")
    
    if [ -n "$LATEST_TAG" ]; then
        log_info "Latest tag: $LATEST_TAG"
        log_info "Current: $CURRENT_TAG"
        
        echo ""
        read -p "Update to $LATEST_TAG? [y/N] " -n 1 -r
        echo ""
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            git checkout "$LATEST_TAG"
        else
            git pull origin main
        fi
    else
        git pull origin main
    fi
    
    # Rebuild
    log_info "Building guardiand..."
    cd "$WORMHOLE_DIR/node"
    
    # Build with version info
    VERSION=$(git describe --tags --always 2>/dev/null || echo "dev")
    go build -ldflags "-X github.com/certusone/wormhole/node/pkg/version.version=$VERSION" \
        -o ../build/bin/guardiand .
    
    log_info "Guardian updated to: $VERSION"
    cd "$ROOT_DIR"
}

update_node() {
    log_step "Updating Node.js packages..."
    
    cd "$ROOT_DIR"
    
    # Update npm packages
    log_info "Updating npm packages..."
    npm update
    
    # Check for outdated
    log_info "Checking for outdated packages..."
    npm outdated || true
    
    log_info "Node.js packages updated"
}

update_deps() {
    log_step "Updating system dependencies..."
    
    if command -v apt-get &> /dev/null; then
        log_info "Updating system packages..."
        sudo apt-get update -qq
        sudo apt-get upgrade -y -qq
        
        # Update Go if installed via official method
        if [ -d "/usr/local/go" ]; then
            log_info "To update Go, download from https://go.dev/dl/"
        fi
        
        log_info "System packages updated"
    else
        log_warn "apt not available. Update packages manually."
    fi
}

update_all() {
    show_versions
    echo ""
    
    log_info "This will update all components."
    log_warn "Make sure all services are stopped first!"
    echo ""
    read -p "Continue? [y/N] " -n 1 -r
    echo ""
    
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        log_info "Cancelled"
        return 0
    fi
    
    update_deps
    echo ""
    update_anvil
    echo ""
    update_guardian
    echo ""
    update_node
    echo ""
    
    log_info "All components updated!"
    show_versions
}

case "${1:-}" in
    all)
        update_all
        ;;
    anvil|foundry)
        update_anvil
        ;;
    guardian)
        update_guardian
        ;;
    node)
        update_node
        ;;
    deps)
        update_deps
        ;;
    version|versions)
        show_versions
        ;;
    *)
        echo "Usage: $0 {all|anvil|guardian|node|deps|version}"
        echo ""
        echo "Commands:"
        echo "  all       Update everything (stop services first!)"
        echo "  anvil     Update Foundry (Anvil, Cast, Forge) via foundryup"
        echo "  guardian  Pull and rebuild guardiand from source"
        echo "  node      Update Node.js npm packages"
        echo "  deps      Update system dependencies"
        echo "  version   Show current versions"
        echo ""
        show_versions
        exit 1
        ;;
esac
