#!/bin/bash
# =============================================================================
# GUARDIAN NODE CONTROL SCRIPT
# =============================================================================
# Usage: bin/guardian {start|stop|restart|status|logs}
# =============================================================================

set -e
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"

# Load configuration
CONFIG_FILE="${CONFIG_FILE:-$ROOT_DIR/config/guardian.conf}"
if [ ! -f "$CONFIG_FILE" ]; then
    echo "Error: Configuration file not found: $CONFIG_FILE"
    echo "Copy config/guardian.conf.example to config/guardian.conf and edit it."
    exit 1
fi
source "$CONFIG_FILE"

# Paths
GUARDIAND="${GUARDIAND_BIN:-$ROOT_DIR/../WormHole-Official-GitHub-Repo/build/bin/guardiand}"
KEY_PATH="$ROOT_DIR/$KEY_FILE"
DATA_PATH="$ROOT_DIR/$DATA_DIR"
LOG_PATH="$ROOT_DIR/$LOG_FILE"
SOCKET_PATH="$ROOT_DIR/$ADMIN_SOCKET"
PID_FILE="$ROOT_DIR/data/guardian-${GUARDIAN_INDEX}.pid"
NODE_KEY_PATH="$ROOT_DIR/keys/node-${GUARDIAN_INDEX}.key"
GRPC_SOCKET_PATH="$ROOT_DIR/data/publicrpc-${GUARDIAN_INDEX}.sock"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log_info()  { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn()  { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

validate_guardiand() {
    if [ ! -f "$GUARDIAND" ]; then
        log_error "guardiand not found at $GUARDIAND"
        echo "Build it: cd WormHole-Official-GitHub-Repo/node && go build -o ../build/bin/guardiand ."
        exit 1
    fi
    if ! file "$GUARDIAND" | grep -q "executable"; then
        log_error "$GUARDIAND is not a valid executable"
        exit 1
    fi
}

is_running() {
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if kill -0 "$PID" 2>/dev/null; then
            return 0
        fi
        rm -f "$PID_FILE"
    fi
    return 1
}

do_start() {
    if is_running; then
        log_warn "Guardian already running (PID: $(cat "$PID_FILE"))"
        exit 1
    fi
    
    validate_guardiand
    
    # Create directories
    mkdir -p "$DATA_PATH" "$(dirname "$LOG_PATH")" "$(dirname "$SOCKET_PATH")" "$(dirname "$KEY_PATH")"
    
    # Build arguments
    ARGS=(
        "node"
        "--network" "$NETWORK_ID"
        "--nodeName" "guardian-$GUARDIAN_INDEX"
        "--port" "$P2P_PORT"
        "--statusAddr" "0.0.0.0:$STATUS_PORT"
        "--publicRPC" "0.0.0.0:$GRPC_PORT"
        "--publicGRPCSocket" "$GRPC_SOCKET_PATH"
        "--adminSocket" "$SOCKET_PATH"
        "--dataDir" "$DATA_PATH"
        "--logLevel" "$LOG_LEVEL"
        "--guardianKey" "$KEY_PATH"
        "--nodeKey" "$NODE_KEY_PATH"
    )
    
    # Key handling
    if [ "$UNSAFE_DEV_MODE" = "true" ]; then
        # In unsafeDevMode, guardian generates deterministic keys based on hostname
        # We must delete existing key to allow regeneration on restart
        if [ -f "$KEY_PATH" ]; then
            log_info "unsafeDevMode: Removing existing key for regeneration"
            rm -f "$KEY_PATH"
        fi
    elif [ ! -f "$KEY_PATH" ]; then
        log_error "Key file not found: $KEY_PATH"
        echo "Generate with: bin/guardian keygen"
        exit 1
    fi
    
    # Ethereum (guardian registry)
    if [ -n "$GETH_RPC" ] && [ "$GETH_RPC" != "ws://0.0.0.0:0" ]; then
        ARGS+=("--ethRPC" "$GETH_RPC" "--ethContract" "$GETH_CONTRACT")
    fi
    
    # Avalanche
    if [ -n "$AVALANCHE_RPC" ]; then
        ARGS+=("--avalancheRPC" "$AVALANCHE_RPC" "--avalancheContract" "$AVALANCHE_CONTRACT")
    fi
    
    # Solana
    if [ -n "$SOLANA_RPC" ] && [ -n "$SOLANA_CONTRACT" ]; then
        ARGS+=("--solanaRPC" "$SOLANA_RPC" "--solanaContract" "$SOLANA_CONTRACT")
    fi
    
    # Bootstrap peers
    [ -n "$BOOTSTRAP_PEERS" ] && ARGS+=("--bootstrap" "$BOOTSTRAP_PEERS")
    
    # Options
    [ "$DISABLE_TELEMETRY" = "true" ] && ARGS+=("--disableTelemetry")
    [ "$UNSAFE_DEV_MODE" = "true" ] && ARGS+=("--unsafeDevMode")
    
    log_info "Starting guardian-$GUARDIAN_INDEX..."
    
    if [ "$1" = "--foreground" ]; then
        exec "$GUARDIAND" "${ARGS[@]}" 2>&1 | tee "$LOG_PATH"
    else
        nohup "$GUARDIAND" "${ARGS[@]}" >> "$LOG_PATH" 2>&1 &
        PID=$!
        echo "$PID" > "$PID_FILE"
        sleep 2
        
        if kill -0 "$PID" 2>/dev/null; then
            log_info "Started (PID: $PID)"
            echo "  Logs: $LOG_PATH"
            echo "  Status: http://0.0.0.0:$STATUS_PORT/metrics"
            echo "  gRPC: 0.0.0.0:$GRPC_PORT"
        else
            log_error "Failed to start. Recent logs:"
            tail -20 "$LOG_PATH"
            exit 1
        fi
    fi
}

do_stop() {
    if ! is_running; then
        log_warn "Guardian not running"
        return 0
    fi
    
    PID=$(cat "$PID_FILE")
    log_info "Stopping guardian-$GUARDIAN_INDEX (PID: $PID)..."
    kill "$PID"
    
    for i in {1..10}; do
        if ! kill -0 "$PID" 2>/dev/null; then
            rm -f "$PID_FILE"
            log_info "Stopped"
            return 0
        fi
        sleep 1
    done
    
    log_warn "Force stopping..."
    kill -9 "$PID" 2>/dev/null || true
    rm -f "$PID_FILE"
    log_info "Stopped"
}

do_status() {
    echo "================================"
    echo "Guardian-$GUARDIAN_INDEX Status"
    echo "================================"
    
    if is_running; then
        PID=$(cat "$PID_FILE")
        MEM=$(ps -o rss= -p "$PID" 2>/dev/null | awk '{print int($1/1024)"MB"}')
        echo -e "Status: ${GREEN}RUNNING${NC} (PID: $PID, Memory: $MEM)"
    else
        echo -e "Status: ${RED}STOPPED${NC}"
    fi
    
    echo ""
    echo "Endpoints:"
    echo "  gRPC: 0.0.0.0:$GRPC_PORT"
    echo "  Metrics: http://0.0.0.0:$STATUS_PORT/metrics"
    echo "  Admin Socket: $SOCKET_PATH"
    echo ""
    echo "Files:"
    echo "  Config: $CONFIG_FILE"
    echo "  Key: $KEY_PATH"
    echo "  Data: $DATA_PATH"
    echo "  Logs: $LOG_PATH"
}

do_logs() {
    if [ "$1" = "-f" ] || [ "$1" = "--follow" ]; then
        tail -f "$LOG_PATH"
    else
        tail -100 "$LOG_PATH"
    fi
}

do_keygen() {
    mkdir -p "$(dirname "$KEY_PATH")"
    if [ -f "$KEY_PATH" ]; then
        log_warn "Key already exists: $KEY_PATH"
        echo "Delete it first to regenerate"
        exit 1
    fi
    
    # Use genkey tool if available
    GENKEY="$ROOT_DIR/bin/genkey"
    if [ -f "$GENKEY" ]; then
        "$GENKEY" "$KEY_PATH" "guardian-$GUARDIAN_INDEX"
    else
        log_error "genkey tool not found. Build it:"
        echo "  cd tools/genkey && go build -o ../../bin/genkey ."
        exit 1
    fi
}

do_version() {
    if [ -f "$GUARDIAND" ]; then
        "$GUARDIAND" version 2>/dev/null || echo "Unknown version"
    else
        echo "Guardian not built. Build with:"
        echo "  cd WormHole-Official-GitHub-Repo/node && go build -o ../build/bin/guardiand ."
    fi
}

case "${1:-}" in
    start)
        do_start "${2:-}"
        ;;
    stop)
        do_stop
        ;;
    restart)
        do_stop
        sleep 2
        do_start
        ;;
    status)
        do_status
        ;;
    logs)
        do_logs "${2:-}"
        ;;
    keygen)
        do_keygen
        ;;
    version)
        do_version
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status|logs|keygen|version}"
        echo ""
        echo "Commands:"
        echo "  start [--foreground]  Start guardian node"
        echo "  stop                  Stop guardian node"
        echo "  restart               Restart guardian node"
        echo "  status                Show guardian status"
        echo "  logs [-f]             Show recent logs (-f to follow)"
        echo "  keygen                Generate guardian key"
        echo "  version               Show guardian version"
        echo ""
        echo "Update:     bin/update guardian"
        exit 1
        ;;
esac

