#!/bin/bash
# =============================================================================
# ANVIL (Local Ethereum) CONTROL SCRIPT
# =============================================================================
# Anvil is simpler than Geth for private networks - it auto-mines blocks.
# Usage: bin/anvil {start|stop|restart|status|logs}
# =============================================================================

set -e
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"

# Paths
PID_FILE="$ROOT_DIR/data/anvil.pid"
LOG_FILE="$ROOT_DIR/logs/anvil.log"
ANVIL_PORT=8545

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log_info()  { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn()  { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

check_anvil() {
    if ! command -v anvil &> /dev/null; then
        log_error "Anvil not installed"
        echo "Install Foundry: curl -L https://foundry.paradigm.xyz | bash && foundryup"
        exit 1
    fi
}

is_running() {
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if kill -0 "$PID" 2>/dev/null; then
            return 0
        fi
        rm -f "$PID_FILE"
    fi
    return 1
}

do_start() {
    if is_running; then
        log_warn "Anvil already running (PID: $(cat "$PID_FILE"))"
        exit 1
    fi
    
    check_anvil
    mkdir -p "$(dirname "$LOG_FILE")" "$ROOT_DIR/data"
    
    log_info "Starting Anvil..."
    
    # State file for persistence
    STATE_FILE="$ROOT_DIR/data/anvil-state.json"
    
    # Start Anvil with:
    # - Chain ID 31337 (same as hardhat/foundry default)
    # - Auto-mine blocks (1 second interval)
    # - Pre-funded accounts
    # - Persistent state (saves every 60 seconds)
    ANVIL_ARGS=(
        --host 0.0.0.0
        --port $ANVIL_PORT
        --chain-id 31337
        --accounts 10
        --balance 10000
        --block-time 1
        --state "$STATE_FILE"
        --state-interval 60
    )
    
    # Load existing state if available
    if [ -f "$STATE_FILE" ]; then
        log_info "Loading state from $STATE_FILE"
        ANVIL_ARGS+=(--load-state "$STATE_FILE")
    fi
    
    nohup anvil "${ANVIL_ARGS[@]}" >> "$LOG_FILE" 2>&1 &
    
    PID=$!
    echo "$PID" > "$PID_FILE"
    sleep 2
    
    if kill -0 "$PID" 2>/dev/null; then
        log_info "Started (PID: $PID)"
        echo "  HTTP: http://0.0.0.0:$ANVIL_PORT"
        echo "  WS:   ws://0.0.0.0:$ANVIL_PORT"
        echo "  Logs: $LOG_FILE"
        echo ""
        echo "Pre-funded accounts (10,000 ETH each):"
        echo "  Account 0: 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266"
        echo "  Private Key: 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"
    else
        log_error "Failed to start. Check logs: $LOG_FILE"
        tail -20 "$LOG_FILE"
        exit 1
    fi
}

do_stop() {
    if ! is_running; then
        log_warn "Anvil not running"
        pkill -f "anvil.*--port $ANVIL_PORT" 2>/dev/null || true
        return 0
    fi
    
    PID=$(cat "$PID_FILE")
    log_info "Stopping Anvil (PID: $PID)..."
    kill "$PID"
    
    for i in {1..10}; do
        if ! kill -0 "$PID" 2>/dev/null; then
            rm -f "$PID_FILE"
            log_info "Stopped"
            return 0
        fi
        sleep 1
    done
    
    log_warn "Force stopping..."
    kill -9 "$PID" 2>/dev/null || true
    rm -f "$PID_FILE"
    log_info "Stopped"
}

do_status() {
    echo "================================"
    echo "Anvil Node Status"
    echo "================================"
    
    if is_running; then
        PID=$(cat "$PID_FILE")
        MEM=$(ps -o rss= -p "$PID" 2>/dev/null | awk '{print int($1/1024)"MB"}')
        echo -e "Status: ${GREEN}RUNNING${NC} (PID: $PID, Memory: $MEM)"
    else
        echo -e "Status: ${RED}STOPPED${NC}"
    fi
    
    echo ""
    echo "Endpoint: http://0.0.0.0:$ANVIL_PORT"
    echo "Logs: $LOG_FILE"
    
    # Test connectivity
    if is_running; then
        echo ""
        echo "Testing connectivity..."
        if curl -s -X POST -H "Content-Type: application/json" \
            --data '{"jsonrpc":"2.0","id":1,"method":"eth_chainId","params":[]}' \
            http://localhost:$ANVIL_PORT | grep -q "result"; then
            echo -e "  RPC: ${GREEN}OK${NC}"
        else
            echo -e "  RPC: ${RED}ERROR${NC}"
        fi
    fi
}

do_logs() {
    if [ "$1" = "-f" ] || [ "$1" = "--follow" ]; then
        tail -f "$LOG_FILE"
    else
        tail -100 "$LOG_FILE"
    fi
}

do_version() {
    if command -v anvil &> /dev/null; then
        anvil --version
    else
        echo "Anvil not installed"
    fi
}

case "${1:-}" in
    start)
        do_start
        ;;
    stop)
        do_stop
        ;;
    restart)
        do_stop
        sleep 2
        do_start
        ;;
    status)
        do_status
        ;;
    logs)
        do_logs "${2:-}"
        ;;
    version)
        do_version
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status|logs|version}"
        echo ""
        echo "Anvil is a fast local Ethereum node (part of Foundry)."
        echo "It auto-mines blocks, making it simpler than Geth for testing."
        echo ""
        echo "Commands:"
        echo "  start     Start Anvil"
        echo "  stop      Stop Anvil"
        echo "  restart   Restart Anvil"
        echo "  status    Show Anvil status"
        echo "  logs [-f] Show recent logs (-f to follow)"
        echo "  version   Show Anvil version"
        exit 1
        ;;
esac

