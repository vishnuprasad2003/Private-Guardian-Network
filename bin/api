#!/bin/bash
# =============================================================================
# VAA API SERVER CONTROL SCRIPT
# =============================================================================
# Usage: bin/api {start|stop|restart|status|logs}
# =============================================================================

set -e
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"

# Load configuration
source "$ROOT_DIR/config/guardian.conf" 2>/dev/null || true

# Paths
API_SCRIPT="$ROOT_DIR/src/api/server.js"
PID_FILE="$ROOT_DIR/data/api.pid"
LOG_FILE="$ROOT_DIR/logs/api.log"
PORT="${API_PORT:-3000}"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log_info()  { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn()  { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

is_running() {
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if kill -0 "$PID" 2>/dev/null; then
            return 0
        fi
        rm -f "$PID_FILE"
    fi
    return 1
}

do_start() {
    if is_running; then
        log_warn "API already running (PID: $(cat "$PID_FILE"))"
        exit 1
    fi
    
    if [ ! -f "$API_SCRIPT" ]; then
        log_error "API script not found: $API_SCRIPT"
        exit 1
    fi
    
    if ! command -v node &> /dev/null; then
        log_error "Node.js not installed"
        exit 1
    fi
    
    mkdir -p "$(dirname "$LOG_FILE")"
    
    log_info "Starting VAA API server..."
    cd "$ROOT_DIR"
    PORT=$PORT nohup node "$API_SCRIPT" >> "$LOG_FILE" 2>&1 &
    
    PID=$!
    echo "$PID" > "$PID_FILE"
    sleep 2
    
    if kill -0 "$PID" 2>/dev/null; then
        log_info "Started (PID: $PID)"
        echo "  URL: http://0.0.0.0:$PORT"
        echo "  Logs: $LOG_FILE"
    else
        log_error "Failed to start. Check logs: $LOG_FILE"
        tail -20 "$LOG_FILE"
        exit 1
    fi
}

do_stop() {
    if ! is_running; then
        log_warn "API not running"
        return 0
    fi
    
    PID=$(cat "$PID_FILE")
    log_info "Stopping API server (PID: $PID)..."
    kill "$PID"
    
    for i in {1..10}; do
        if ! kill -0 "$PID" 2>/dev/null; then
            rm -f "$PID_FILE"
            log_info "Stopped"
            return 0
        fi
        sleep 1
    done
    
    log_warn "Force stopping..."
    kill -9 "$PID" 2>/dev/null || true
    rm -f "$PID_FILE"
    log_info "Stopped"
}

do_status() {
    echo "================================"
    echo "VAA API Server Status"
    echo "================================"
    
    if is_running; then
        PID=$(cat "$PID_FILE")
        MEM=$(ps -o rss= -p "$PID" 2>/dev/null | awk '{print int($1/1024)"MB"}')
        echo -e "Status: ${GREEN}RUNNING${NC} (PID: $PID, Memory: $MEM)"
    else
        echo -e "Status: ${RED}STOPPED${NC}"
    fi
    
    echo ""
    echo "Endpoint: http://0.0.0.0:$PORT"
    echo "Logs: $LOG_FILE"
    
    # Test connectivity
    if is_running; then
        echo ""
        echo "Testing connectivity..."
        if curl -s "http://localhost:$PORT/health" | grep -q "ok"; then
            echo -e "  Health: ${GREEN}OK${NC}"
        else
            echo -e "  Health: ${RED}ERROR${NC}"
        fi
    fi
}

do_logs() {
    if [ "$1" = "-f" ] || [ "$1" = "--follow" ]; then
        tail -f "$LOG_FILE"
    else
        tail -100 "$LOG_FILE"
    fi
}

case "${1:-}" in
    start)
        do_start
        ;;
    stop)
        do_stop
        ;;
    restart)
        do_stop
        sleep 2
        do_start
        ;;
    status)
        do_status
        ;;
    logs)
        do_logs "${2:-}"
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status|logs}"
        echo ""
        echo "Commands:"
        echo "  start     Start API server"
        echo "  stop      Stop API server"
        echo "  restart   Restart API server"
        echo "  status    Show API status"
        echo "  logs [-f] Show recent logs (-f to follow)"
        exit 1
        ;;
esac

