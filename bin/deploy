#!/bin/bash
# =============================================================================
# CONTRACT DEPLOYMENT SCRIPT
# =============================================================================
# Deploys Wormhole contracts to EVM chains.
#
# Usage: bin/deploy <target> [guardian_addresses]
#
# Targets:
#   anvil      - Deploy to local Anvil node (localhost:8545)
#   avalanche  - Deploy to Avalanche L1 subnet
#
# Environment:
#   PRIVATE_KEY           - Deployer private key (required for avalanche)
#   AVALANCHE_RPC_HTTP    - Avalanche HTTP RPC URL
#   GUARDIAN_ADDRESSES    - Comma-separated guardian addresses
#
# Examples:
#   bin/deploy anvil
#   bin/deploy avalanche "0xbeFA429d57cD18b7F8A4d91A2da9AB4AF05d0FBe"
# =============================================================================

set -e
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log_info()  { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn()  { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

# Load config
source "$ROOT_DIR/config/guardian.conf" 2>/dev/null || true

# Default guardian address (devnet mode)
DEFAULT_GUARDIAN="0xbeFA429d57cD18b7F8A4d91A2da9AB4AF05d0FBe"

# Anvil pre-funded account
ANVIL_PRIVATE_KEY="ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"

show_usage() {
    echo "Usage: $0 <target> [guardian_addresses]"
    echo ""
    echo "Targets:"
    echo "  anvil      Deploy to local Anvil (localhost:8545)"
    echo "  avalanche  Deploy to Avalanche L1 subnet"
    echo ""
    echo "Guardian Addresses:"
    echo "  Single:   \"0xbeFA429d57cD18b7F8A4d91A2da9AB4AF05d0FBe\""
    echo "  Multiple: \"0xaddr1,0xaddr2,0xaddr3\""
    echo ""
    echo "Examples:"
    echo "  $0 anvil"
    echo "  $0 anvil \"0xbeFA429d57cD18b7F8A4d91A2da9AB4AF05d0FBe\""
    echo "  $0 avalanche \"0xbeFA429d57cD18b7F8A4d91A2da9AB4AF05d0FBe\""
    echo ""
    echo "Environment:"
    echo "  PRIVATE_KEY         - Deployer private key (required for avalanche)"
    echo "  AVALANCHE_RPC_HTTP  - Avalanche HTTP RPC (default from config)"
    echo ""
    echo "Default guardian addresses (unsafeDevMode):"
    echo "  guardian-0: 0xbeFA429d57cD18b7F8A4d91A2da9AB4AF05d0FBe"
    echo "  guardian-1: 0x88D7D8B32a9105d228100E72dFFe2Fae0705D31c"
    echo "  guardian-2: 0x58076F561CC62A47087B567C86f986426dFCD000"
}

deploy_anvil() {
    local GUARDIANS="${1:-$DEFAULT_GUARDIAN}"
    
    log_info "Deploying to Anvil (localhost:8545)..."
    
    # Check if Anvil is running
    if ! curl -s http://localhost:8545 > /dev/null 2>&1; then
        log_error "Anvil not running. Start it with: bin/anvil start"
        exit 1
    fi
    
    export PRIVATE_KEY="$ANVIL_PRIVATE_KEY"
    
    "$ROOT_DIR/scripts/deploy/deploy-evm.sh" geth "http://localhost:8545" "$GUARDIANS"
    
    echo ""
    log_info "Update config/guardian.conf with the GETH_CONTRACT address above"
}

deploy_avalanche() {
    local GUARDIANS="${1:-$DEFAULT_GUARDIAN}"
    
    # Get RPC URL
    local RPC="${AVALANCHE_RPC_HTTP:-}"
    if [ -z "$RPC" ]; then
        # Convert WebSocket to HTTP if needed
        if [ -n "$AVALANCHE_RPC" ]; then
            RPC=$(echo "$AVALANCHE_RPC" | sed 's|ws://|http://|' | sed 's|/ws$|/rpc|')
        fi
    fi
    
    if [ -z "$RPC" ]; then
        log_error "AVALANCHE_RPC_HTTP not set and couldn't determine from config"
        echo "Set: export AVALANCHE_RPC_HTTP=\"http://your-avalanche-node/rpc\""
        exit 1
    fi
    
    if [ -z "$PRIVATE_KEY" ]; then
        log_error "PRIVATE_KEY not set"
        echo "Set: export PRIVATE_KEY=\"0x...\""
        exit 1
    fi
    
    log_info "Deploying to Avalanche..."
    log_info "RPC: $RPC"
    
    "$ROOT_DIR/scripts/deploy/deploy-evm.sh" avalanche "$RPC" "$GUARDIANS"
    
    echo ""
    log_info "Update config/guardian.conf with the AVALANCHE_CONTRACT address above"
}

case "${1:-}" in
    anvil|local)
        deploy_anvil "${2:-}"
        ;;
    avalanche|avax)
        deploy_avalanche "${2:-}"
        ;;
    -h|--help|help)
        show_usage
        ;;
    *)
        show_usage
        exit 1
        ;;
esac

