
*~
# All paths are configurable in configs/guardian-N.conf
# Anvil temporary files (redirected to BASE_DIR/.foundry)
*.backup
backups/
*.bak
build/
# Build artefacts
*.code-workspace
contracts/evm/*.bytecode
contracts/solana/program-id.json
contracts/solana/program-keypair.json
data/
# Deployment artifacts
.DS_Store
# Editors
.foundry/
~/.foundry/
# Foundry cache/data (stored under BASE_DIR/.foundry, redirected via symlink)
.foundryup
.idea/
keys/
*.log.*
*.log.gz
logs/
node_modules/
# OS
*.pid
pids/
__pycache__/
# Runtime data (stored under BASE_DIR, default /solana/wormhole)
sockets/
*.swo
*.swp
target/
# Temporary files
Thumbs.db
*.tmp
.vscode/
