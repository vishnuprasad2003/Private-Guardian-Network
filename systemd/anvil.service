[Unit]
Description=Anvil Local Ethereum Node (Guardian Registry)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=guardian
Group=guardian
WorkingDirectory=/opt/guardian-network

# Anvil with persistent state
ExecStart=/home/guardian/.foundry/bin/anvil \
    --host 0.0.0.0 \
    --port 8545 \
    --chain-id 31337 \
    --accounts 10 \
    --balance 10000 \
    --block-time 1 \
    --state /opt/guardian-network/data/anvil-state.json \
    --state-interval 60

Restart=always
RestartSec=10
StandardOutput=append:/opt/guardian-network/logs/anvil.log
StandardError=append:/opt/guardian-network/logs/anvil.log

# Security
NoNewPrivileges=true
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/opt/guardian-network/data /opt/guardian-network/logs

# Resource limits
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target

