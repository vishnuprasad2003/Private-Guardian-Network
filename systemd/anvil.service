[Unit]
Description=Anvil Local EVM Node (Guardian Registry Storage)
Documentation=https://github.com/foundry-rs/foundry
After=network-online.target
Wants=network-online.target
PartOf=guardian.target

[Service]
Type=simple
User=__GUARDIAN_USER__
Group=__GUARDIAN_GROUP__
WorkingDirectory=__WORKSPACE_ROOT__
Environment="WORKSPACE_ROOT=__WORKSPACE_ROOT__"
Environment="PATH=/solana/wormhole/.foundry/bin:/usr/local/bin:/usr/bin:/bin"
Environment="FOUNDRY_CACHE_DIR=/solana/wormhole/.foundry/cache"
Environment="FOUNDRY_DATA_DIR=/solana/wormhole/.foundry/data"

# RUN_FOREGROUND=1 makes start-anvil.sh `exec` anvil so THIS is the tracked main
# PID; Restart=on-failure then actually restarts the real process on a crash.
ExecStart=/bin/bash -lc 'cd "__WORKSPACE_ROOT__"; export RUN_FOREGROUND=1; exec ./scripts/start-anvil.sh'

# On stop, systemd sends SIGTERM to anvil; it flushes --state on clean shutdown.
# Give it time to write anvil-state.json before SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=30

Restart=always
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=anvil

# Resource limits
LimitNOFILE=65535
LimitNPROC=32768
MemoryAccounting=true
CPUAccounting=true

[Install]
WantedBy=multi-user.target guardian.target
