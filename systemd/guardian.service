[Unit]
Description=Wormhole Guardian Node
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=guardian
Group=guardian
WorkingDirectory=/opt/guardian-network
ExecStart=/opt/guardian-network/bin/guardian start --foreground
ExecStop=/opt/guardian-network/bin/guardian stop
Restart=always
RestartSec=10
StandardOutput=append:/opt/guardian-network/logs/guardian-0.log
StandardError=append:/opt/guardian-network/logs/guardian-0.log

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/guardian-network/data /opt/guardian-network/logs /opt/guardian-network/keys

# Resource limits
LimitNOFILE=65535
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
